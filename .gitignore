.ipynb_checkpoints/
*.ipynb_checkpoints

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
env/
.venv/
.env

# macOS
.DS_Store
.AppleDouble
.LSOverride

# IDEs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Large datasets (> 50 MB) — stored via Git LFS or Kaggle link
# data/upi_transactions_2024.csv   ← 28 MB (kept — under GitHub 50 MB soft limit)

# Model artifacts (regenerated by running notebook Cell 20)
# models/fraud_model.joblib        ← 29 MB kept for live demo

# Backup HTML files
app/templates/index.backup*.html

# Generator scripts (internal tooling)
generate_viva_pdf.py
add_notes.py
make_ppt.py

# OS
Thumbs.db
ehthumbs.db
Desktop.ini
